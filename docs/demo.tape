Output docs/demo.gif
Set Shell bash
Set FontSize 16
Set Width 1100
Set Height 650
Set TypingSpeed 60ms

Type "./publish/rs" Enter
Sleep 2s
Type "ls" Enter
Sleep 1.5s
Type "mkdir demo" Enter
Sleep 1s
Type "cd demo" Enter
Sleep 1s
Type "upload ~/holiday.mp4" Enter
Sleep 5s
Type "upload ~/holiday.mp4" Enter
Sleep 2s
Type "mkdir videos" Enter
Sleep 1s
Type "mv holiday.mp4 videos" Enter
Sleep 1s
Type "tree" Enter
Sleep 2.5s
Type "cd .." Enter
Sleep 1s
Type "rm demo" Enter
Sleep 1.5s
Type "y" Enter
Sleep 1.5s
Type "exit" Enter
Sleep 1s
